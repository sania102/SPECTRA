APP_ENV=development
# Required: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Optional: enables AI query planning, claim extraction and explanations.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Comma-separated models tried in order if LLM_MODEL is rejected by your provider.
LLM_FALLBACK_MODELS=gpt-4.1-mini,gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (Groq, Together, OpenRouter, Ollama ...).
LLM_BASE_URL=
CORS_ORIGINS=http://localhost:3000
SERPAPI_TIMEOUT_SECONDS=30
SERPAPI_MAX_RETRIES=2
SERPAPI_CACHE_TTL_SECONDS=900
LOG_LEVEL=INFO
